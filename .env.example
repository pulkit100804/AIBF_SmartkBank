# SmartBank AI - Environment Configuration
# Copy to .env and modify as needed: cp .env.example .env

# Optional: Google Gemini API key for AI-enhanced explanations
# The application works fully without this key (template-based fallback)
# GOOGLE_API_KEY=your_api_key_here

# Database filename (default: smartbank_ai.db)
# DB_NAME=smartbank_ai.db

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
